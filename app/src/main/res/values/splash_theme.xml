<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Older Android starts with the rest pose; the compat exit view plays the AVD. -->
    <item name="scaniqo_splash_icon" type="drawable">@drawable/scaniqo_splash_vector</item>
    <style name="Theme.Scaniqo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/scaniqo_brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/scaniqo_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">@integer/scaniqo_splash_duration</item>
        <item name="postSplashScreenTheme">@style/Theme.Scaniqo</item>
        <item name="android:statusBarColor">@color/scaniqo_brand_background</item>
        <item name="android:navigationBarColor">@color/scaniqo_brand_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
