        <keyframe android:fraction="0.86" android:value="3.6" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.885" android:value="2.2" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.905" android:value="2.2" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.94" android:value="3.6" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="1" android:value="3.6" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </propertyValuesHolder>
</objectAnimator>
