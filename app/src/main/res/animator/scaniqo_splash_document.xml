<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/scaniqo_splash_duration"
    android:interpolator="@android:interpolator/linear"
    android:repeatCount="0">
    <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.12" android:value="-3" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.28" android:value="3" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.43" android:value="-2" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.56" android:value="0.6" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.65" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.12" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.28" android:value="-1.5" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.43" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.56" android:value="-0.3" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.65" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="-8" />
        <keyframe android:fraction="0.12" android:value="-14" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.28" android:value="2" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.43" android:value="-12" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.56" android:value="-6" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.65" android:value="-8" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="1" android:value="-8" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </propertyValuesHolder>
</objectAnimator>
