<?xml version="1.0" encoding="utf-8"?>
<!-- Opacity only: the original rear corner stays still while the foreground frame searches. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/scaniqo_splash_duration"
    android:interpolator="@android:interpolator/linear"
    android:repeatCount="0">
    <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="1" />
        <keyframe android:fraction="0.02" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.025" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.82" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="0.825" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </propertyValuesHolder>
</objectAnimator>
