<?xml version="1.0" encoding="utf-8"?>
<!-- One coherent frame follows seven cubic curves with matching tangents. -->
<!-- The timing curve changes speed continuously and reaches the final pose at 82%. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
